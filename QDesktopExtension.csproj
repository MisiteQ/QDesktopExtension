<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>QDesktopExtension</RootNamespace>
    <AssemblyName>QDesktopExtension</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- VideoEncoder / InkPen 使用指针操作 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 程序集元信息：面板“关于”页与 exe 属性页共用同一份来源 -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>QDesktopExtension</Product>
    <AssemblyTitle>QDesktopExtension 桌面扩展平台</AssemblyTitle>
    <Company>Misite齊</Company>
    <Authors>Misite齊</Authors>
    <Copyright>© 2026 Misite齊</Copyright>
    <Description>桌面扩展 / 屏幕串流服务：浏览器实时查看电脑画面并反向操作。</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Fleck" Version="1.0.2" />
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLoaded" Version="8.1.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\index.html" LogicalName="index.html" />
    <EmbeddedResource Include="Resources\app.ico" LogicalName="app.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Include="appconfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
